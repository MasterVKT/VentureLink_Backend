# Django
DJANGO_ENV=development  # development, test, production
DJANGO_SECRET_KEY=change_me_with_strong_secret_key

# Base de données (pour PostgreSQL en production)
DB_NAME=venturelink
DB_USER=venturelink_user
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432

# Email (pour production)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email_user
EMAIL_HOST_PASSWORD=your_email_password

# Redis
REDIS_URL=redis://localhost:6379/0

# Firebase
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id
FIREBASE_DATABASE_URL=https://your_project.firebaseio.com

# My-CoolPay
PAYMENT_SANDBOX_MODE=True
MYCOOLPAY_SANDBOX_PUBLIC_KEY=your_mycoolpay_sandbox_public_key
MYCOOLPAY_SANDBOX_PRIVATE_KEY=your_mycoolpay_sandbox_private_key
MYCOOLPAY_PUBLIC_KEY=your_mycoolpay_public_key
MYCOOLPAY_PRIVATE_KEY=your_mycoolpay_private_key
MYCOOLPAY_SANDBOX_WEBHOOK_SECRET=your_mycoolpay_sandbox_webhook_secret
MYCOOLPAY_PRODUCTION_WEBHOOK_SECRET=your_mycoolpay_production_webhook_secret
MYCOOLPAY_ALLOWED_IPS=127.0.0.1,192.168.1.1

# Currency Exchange API
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# URLs
SITE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Sentry
SENTRY_DSN=your_sentry_dsn
SENTRY_TRACES_SAMPLE_RATE=0.1
DJANGO_ENVIRONMENT=development
 